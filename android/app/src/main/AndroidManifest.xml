<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Task 4.7 — latent bug caught while adding this task's own
         permissions: INTERNET was declared only in the debug/profile
         manifests (android/app/src/debug and .../profile), which is
         normal Flutter-template boilerplate for the tooling's own VM
         service connection — NOT a substitute for declaring it here.
         Every real-device run so far has used `flutter run` (debug),
         so this app's actual networking (every `dio` call in this
         codebase) has been working by accident of which manifest was
         active; a release build would have had no network access at
         all. Flagged, not silently fixed only here — see
         test_cases/TEST_CASE_LOG.md's "Open cross-cutting items" for
         this task. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Task 4.7 — zego_uikit_prebuilt_call's own documented Android
         requirements (community quick-start guide, since the official
         docs' own "Configure your project" section didn't list these
         explicitly — see pubspec.yaml's comment on this dependency for
         the full version-floor research). CAMERA and RECORD_AUDIO
         below are already declared for Tasks 2.5/4.8. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Task 2.7 — background location service. Foreground-only location
         (FR-C1 / the handbook both scope this to "while the app is
         active"), so this deliberately does NOT request
         ACCESS_BACKGROUND_LOCATION, which would need Android's separate
         "Allow all the time" flow and a lot more plumbing than this task
         calls for. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Task 3.14 — Android 13+ (API 33+) requires this runtime permission
         before any notification (local or push-driven) can be shown; below
         33 it's a no-op permission granted automatically. Requested at
         runtime by PushService, not assumed from the manifest alone. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Task 4.8 — priority voice messages. The `record` plugin's
         AudioRecorder.start() needs this at runtime (requested via its
         own hasPermission(), not assumed from the manifest alone, same
         as POST_NOTIFICATIONS above); without the manifest entry the OS
         would refuse the runtime grant outright. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <application
        android:label="humsafar_talha_frontend"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Task 3.14 — the channel the OS uses for a push's own `notification`
             payload when it auto-displays one (app backgrounded/terminated).
             Must match one of the channel ids PushService creates
             (lib/core/push/push_service.dart) — "standard_alerts" here as the
             safe default; a critical push still carries priority: "critical"
             in its data, which the foreground handler reads to pick the
             high-importance channel instead when the app IS in front. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="standard_alerts" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Task 3.14 — required on Android 11+ (API 30+) package-visibility
             rules so url_launcher's canLaunchUrl/launchUrl can see the
             device's dialer app for the "Call" buttons (mockups 08b, 24). -->
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
    </queries>
</manifest>
